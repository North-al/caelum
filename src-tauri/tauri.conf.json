{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Caelum",
    "version": "1.5.0",
    "identifier": "com.north.caelum",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Caelum",
                "width": 1200,
                "height": 760,
                "minWidth": 900,
                "minHeight": 560,
                "decorations": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "publisher": "North",
        "category": "Productivity",
        "shortDescription": "本地 Markdown 笔记应用",
        "longDescription": "Caelum 是一款本地优先的 Markdown 笔记应用，支持编辑、预览、大纲与工作区资源管理。",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "fileAssociations": [
            {
                "ext": ["md", "markdown"],
                "name": "Markdown",
                "description": "Markdown 文档",
                "mimeType": "text/markdown",
                "role": "Editor"
            },
            {
                "ext": ["txt", "ini"],
                "name": "Plain Text",
                "description": "文本文档",
                "mimeType": "text/plain",
                "role": "Editor"
            },
            {
                "ext": ["json", "xml", "svg"],
                "name": "Structured Text",
                "description": "结构化文本",
                "mimeType": "text/plain",
                "role": "Editor"
            }
        ],
        "windows": {
            "nsis": {
                "installMode": "both",
                "languages": ["SimpChinese", "English"],
                "displayLanguageSelector": true,
                "installerIcon": "icons/icon.ico",
                "uninstallerIcon": "icons/icon.ico",
                "startMenuFolder": "Caelum"
            }
        }
    }
}
